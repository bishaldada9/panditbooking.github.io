APP_ENV=development
APP_PORT=8081
APP_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=ritual_user
DB_PASSWORD=ritual_pass_secure
DB_NAME=hindu_ritual_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# MFA
MFA_ISSUER=BishalPujaSewa

# Email (SendGrid)
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@bishalpujasewa.com
EMAIL_FROM_NAME=Bishal Puja Sewa

# Payment Gateways
ESEWA_MERCHANT_ID=your-esewa-merchant-id
ESEWA_SECRET=your-esewa-secret
KHALTI_MERCHANT_ID=your-khalti-merchant-id
KHALTI_SECRET=your-khalti-secret
PAYMENT_MOCK_MODE=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:80,http://localhost:8081

# Rate Limit
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_BURST=50
